# ---------------------------------------------------------------------------
# TRACKED IN GIT AS OF 2026-09-18. This file is not merely environment glue --
# it carries the experiment's hyperparameters (ROGUE_ONE_K_FOLDS,
# ROGUE_ONE_TRAIN_SIZE, ROGUE_ONE_NUM_ITERATIONS, every agent temperature and
# reasoning effort). Those determine results, so for a pre-registered study they
# belong under version control. It was previously caught by .gitignore:161 and
# therefore invisible; phantom_menace/config.yml was invisible the same way and
# silently reverted within 24 hours of being fixed (HQ #126).
#
# NO REAL SECRETS HERE. LLM_API_KEY and EMBEDD_API_KEY are the shared token the
# local vLLM servers are started with and called with on localhost -- they are
# not credentials for anything outside this box. Real secrets (WANDB_API_KEY,
# SERPER_API_KEY) live in .secret.env, which stays git-ignored. Keep it that way.
# ---------------------------------------------------------------------------
LLM_MODEL="openai/gpt-oss-20b"
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=3
LLM_PORT=8010
# LLM_API_KEY moved to .secret.env on 2026-09-18 -- see the header above.
# NOTE 2026-09-18: this container is launched PINNED with --gpus device=4,5,6,
# so CUDA devices are renumbered CONTAINER-LOCAL 0,1,2 (= physical 4,5,6).
# The values below are therefore container-local indices, NOT physical ones.
# They previously read 2,3 / 4 (physical), which under a pinned launch selected
# a nonexistent device: vLLM aborted with 'World size (2) is larger than the
# number of available GPUs (1)' and the daemons died as zombies with their
# output going to /dev/null, so the loop waited forever with no error visible.
LLM_GPUS="0,1"


EMBEDD_MODEL="Qwen/Qwen3-Embedding-4B"
EMBEDD_PORT=8011
# EMBEDD_API_KEY moved to .secret.env on 2026-09-18 -- see the header above.
EMBEDD_GPUS="2"


# DEAD SETTING (verified 2026-09-18): nothing reads VECTOR_DB_PATH or
# VECTOR_DB_COLLECTION -- a grep over rogueone/, phantom_menace/ and the
# top-level scripts returns no hits. The path also points at
# /workspaces/BrainFlux/vector_db, a VS Code devcontainer location that does
# not exist on CAIR: the same stale-/workspaces/ class of bug that left the
# knowledge store silently empty for a whole run. Commented out rather than
# deleted so the next person sees it was retired deliberately.
# VECTOR_DB_PATH="/workspaces/BrainFlux/vector_db"
# VECTOR_DB_COLLECTION="brainflux_literature"


ROGUE_ONE_NUM_ITERATIONS=10
ROGUE_ONE_TRAIN_SIZE=0.8
ROGUE_ONE_DO_LOGGING="True"
ROGUE_ONE_K_FOLDS=5
ROGUE_ONE_DO_BALANCING="False"


CONSOLE_DISABLE=False


# AGENT SETTINGS

## Extractor Agent settings
EXTRACTION_AGENT_TEMPERATURE=0.3
EXTRACTION_AGENT_REASONING_EFFORT="medium"
EXTRACTION_AGENT_MAX_ITERATIONS=200

## Medical Knowledge Agent settings
MEDICAL_KNOWLEDGE_AGENT_TEMPERATURE=0.7
MEDICAL_KNOWLEDGE_AGENT_REASONING_EFFORT="low"
MEDICAL_KNOWLEDGE_AGENT_MAX_ITERATIONS=400

## Tester Agent settings
TESTER_AGENT_TEMPERATURE=0.3
TESTER_AGENT_REASONING_EFFORT="high"  
TESTER_AGENT_MAX_ITERATIONS=100

## Orchestrator Agent settings
ORCHESTRATOR_AGENT_TEMPERATURE=0.7  
ORCHESTRATOR_AGENT_REASONING_EFFORT="high"
ORCHESTRATOR_AGENT_MAX_ITERATIONS=200